---
import { render } from 'astro:content'
import Questions from '../components/questions.astro'
import Base from '../layouts/base.astro'
import { pillarEntry, visibleEntry } from '../lib/entries.ts'
import { guideClusters } from '../lib/entry-schema.ts'
import { strings } from '../strings.en.ts'

// The glossary terms the pillar's text is about, in reading order.
const terms = ['planning-poker', 'story-points', 'fibonacci-sequence', 'sprint-planning', 'velocity'] as const

const entry = await pillarEntry()
const { Content } = await render(entry)

// The cluster pages and terms are linked only where this build shows them, so no published page links a draft.
const clusters = []
for (const id of guideClusters) {
  const page = await visibleEntry('guides', id)
  if (page) clusters.push({ title: page.data.title, href: `/guides/${id}` })
}
const related = []
for (const id of terms) {
  const term = await visibleEntry('glossary', id)
  if (term) related.push({ title: term.data.title, href: `/glossary/${id}` })
}
const isoDay = (date: Date) => date.toISOString().slice(0, 10)
---

<Base title={entry.data.title} description={entry.data.description}>
  <article id="master-the-art-of-planning-poker">
    <Content />
    <p>
      <time datetime={entry.data.published.toISOString()}>{isoDay(entry.data.published)}</time>
      {
        entry.data.updated && (
          <>
            {' • '}
            {strings.updatedLabel} <time datetime={entry.data.updated.toISOString()}>{isoDay(entry.data.updated)}</time>
          </>
        )
      }
    </p>
    {
      clusters.length > 0 && (
        <nav aria-label={strings.moreGuides}>
          <h2>{strings.moreGuides}</h2>
          <ul>
            {clusters.map((link) => (
              <li>
                <a href={link.href}>{link.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {
      related.length > 0 && (
        <nav aria-label={strings.relatedTerms}>
          <h2>{strings.relatedTerms}</h2>
          <ul>
            {related.map((link) => (
              <li>
                <a href={link.href}>{link.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <Questions questions={entry.data.questions} />
  </article>
</Base>
