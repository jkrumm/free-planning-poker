---
import SoftwareApplication from '../components/schema/software-application.astro'
import Base from '../layouts/base.astro'
---

<Base description="The best free planning poker app for agile teams and story point estimation. Incredibly user-friendly planning tool. Open source and privacy focused.">
  <SoftwareApplication slot="structured-data" />
  <h1>Free-Planning-Poker.com</h1>

  <section id="features">
    <h2>Powerful Yet Simple</h2>
    <h3>Essential Features for Effective Sprint Planning</h3>
    <div>
      <p><strong>Share Room URL</strong> - Click the room name to copy the URL.</p>
      <p><strong>Room Reset</strong> - Reset all votes with a single tap.</p>
      <p><strong>Spectator Mode</strong> - For those who are not involved in estimations.</p>
      <p><strong>Auto Show</strong> - Automatically reveal estimations once everyone has voted.</p>
    </div>
    <div>
      <p>
        <strong>Voting analytics</strong> - Gain insights into participation, efficiency, and trends in your voting
        sessions. To improve your sprint planning in the future.
      </p>
    </div>
    <div>
      <p><strong>User Settings</strong> Change your username and toggle sounds and popup notifications.</p>
    </div>
    <div>
      <p><strong>Roadmap</strong> - There is much more to come!</p>
      <p><a href="/roadmap">Go to Roadmap</a></p>
    </div>
  </section>

  <section id="privacy">
    <h2>Protecting Your Privacy</h2>
    <h3>
      Our approach is clear: no cookies, no third-party tracking, your IP is never stored — built around GDPR
      principles.
    </h3>
    <p>
      <a href="/privacy">Full Privacy Policy</a>
      <a href="https://github.com/jkrumm/free-planning-poker" target="_blank" rel="noopener noreferrer">GitHub</a>
    </p>
    <ul>
      <li>No cookies</li>
      <li>GDPR Compliant</li>
      <li>No IP Stored</li>
      <li>Anonymized Analytics</li>
      <li>Open Source</li>
    </ul>
  </section>

  <section id="guide">
    <h2>Planning Poker Guide</h2>
    <p>
      Discover how Planning Poker helps Agile teams efficiently plan sprints using story points. Understand the benefits
      of anonymity and gamification in achieving accurate task estimations.
    </p>
    <p><a href="/guide">Planning Poker Guide</a></p>
  </section>

  <section id="contact">
    <h2>Reach Out to Us</h2>
    <p>
      Your input is valuable to us!<br />Feedback, questions, feature suggestions, or if you want to contribute, we’re
      here to listen and assist.
    </p>
    <p><a href="/contact">Contact Form</a></p>
  </section>
</Base>
