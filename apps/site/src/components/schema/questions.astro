---
import { strings } from '../../strings.en.ts'
import { faqPage, type QuestionInput } from './faq-page.ts'
import { jsonLd } from './json-ld.ts'

interface Props {
  questions: readonly QuestionInput[]
}

const { questions } = Astro.props
---

{
  questions.length > 0 && (
    <section>
      <h2>{strings.questionsHeading}</h2>
      <dl>
        {questions.map((item) => (
          <>
            <dt>{item.question}</dt>
            <dd>{item.answer}</dd>
          </>
        ))}
      </dl>
      <script type="application/ld+json" is:inline set:html={jsonLd(faqPage(questions))} />
    </section>
  )
}
