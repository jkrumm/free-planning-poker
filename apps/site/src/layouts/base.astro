---
import BreadcrumbList from '../components/schema/breadcrumb-list.astro'
import Organization from '../components/schema/organization.astro'
import WebSite from '../components/schema/web-site.astro'
import { breadcrumbs } from '../lib/breadcrumbs.ts'
import { canonicalPath } from '../lib/canonical.ts'
import { sectionEntries } from '../lib/entries.ts'
import { socialImagePath, socialImageSize } from '../lib/social.ts'
import { strings } from '../strings.en.ts'

interface Props {
  /** The page's own title; the home page passes none and gets the site title. */
  title?: string
  description: string
  /** Draft on the beta build: a draft line and robots noindex. */
  draft?: boolean
  /** Keep the page out of every index (the 404 page). */
  noindex?: boolean
  /** The Open Graph type: an article for a page with a published date, a website for the rest. */
  type?: 'website' | 'article'
}

const { title, description, draft = false, noindex = false, type = 'website' } = Astro.props
const pageTitle = title ? strings.titlePrefix + title : strings.homeTitle
const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site).href
const robots = draft || noindex ? 'noindex, nofollow' : 'index, follow'
// social-images.ts writes the file at the end of the build, from this page's og:title and og:description.
const socialImage = new URL(socialImagePath(Astro.url.pathname), Astro.site).href
// A page that is kept out of every index has no trail to show.
const crumbs = noindex || draft ? [] : breadcrumbs(Astro.url.pathname, title ?? pageTitle)
const year = new Date().getFullYear()
// /blog exists only while this build shows a post (src/pages/blog), so the footer links it on the same condition.
const blogVisible = (await sectionEntries('blog')).length > 0
// /vs is the same: no index page, so no link, while the build shows no comparison.
const vsVisible = (await sectionEntries('vs')).length > 0
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta property="og:site_name" content={strings.siteName} />
    <meta property="og:locale" content="en" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(socialImageSize.width)} />
    <meta property="og:image:height" content={String(socialImageSize.height)} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <Organization />
    <WebSite />
    <slot name="structured-data" />
    {crumbs.length > 0 && <BreadcrumbList crumbs={crumbs} />}
  </head>
  <body id="top">
    <header>
      <a href="/">{strings.siteName}</a>
      <nav aria-label={strings.navLabel}>
        <ul>
          {strings.nav.map((item) => <li><a href={item.href}>{item.title}</a></li>)}
        </ul>
      </nav>
    </header>
    {draft && <p>{strings.draftLine}</p>}
    <main>
      <slot />
    </main>
    <footer>
      <p>
        © {year} • <a href={strings.releases.href}>{strings.releases.title}</a> •
        <a href={strings.license.href}>{strings.license.title}</a>
      </p>
      <p>{strings.credit}</p>
      <nav aria-label={strings.footerLabel}>
        <ul>
          {strings.footerPages.map((item) => <li><a href={item.href}>{item.title}</a></li>)}
          {blogVisible && <li><a href={strings.blog.href}>{strings.blog.title}</a></li>}
          {vsVisible && <li><a href={strings.vs.href}>{strings.vs.indexTitle}</a></li>}
        </ul>
        <ul>
          {strings.footerLegal.map((item) => <li><a href={item.href}>{item.title}</a></li>)}
        </ul>
      </nav>
      <p><a href="#top">{strings.backToTop}</a></p>
    </footer>
  </body>
</html>
