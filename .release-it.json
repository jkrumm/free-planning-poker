{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagName": "${version}",
    "tagAnnotation": "Release ${version}",
    "tag": true,
    "commit": true,
    "push": true,
    "requireCleanWorkingDir": true,
    "requireBranch": "master"
  },
  "github": {
    "release": true,
    "releaseName": "Release ${version}",
    "tokenRef": "GITHUB_TOKEN"
  },
  "npm": {
    "publish": false
  },
  "hooks": {
    "before:init": ["git pull"],
    "after:release": ["git pull", "echo Successfully released ${name} v${version}"]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "header": "# Changelog\n\nAll notable changes to this project will be documented in this file.\n",
      "preset": {
        "name": "conventionalcommits",
        "types": [
          { "type": "feat", "section": "Features", "effect": "bump" },
          { "type": "fix", "section": "Bug Fixes", "effect": "bump" },
          { "type": "perf", "section": "Performance", "effect": "bump" },
          { "type": "refactor", "section": "Refactoring", "effect": "bump" },
          { "type": "docs", "section": "Documentation", "effect": "bump" },
          { "type": "ci", "section": "CI/CD", "effect": "bump" },
          { "type": "chore", "effect": "hidden" },
          { "type": "test", "effect": "hidden" },
          { "type": "style", "effect": "hidden" },
          { "type": "build", "effect": "hidden" }
        ]
      }
    }
  }
}
