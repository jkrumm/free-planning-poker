{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": false,
  "ignorePatterns": [
    "**/*.md",
    "docs/**",
    "bun.lock",
    ".claude/**",
    "**/routeTree.gen.ts",
    "packages/i18n/locales/**"
  ]
}
