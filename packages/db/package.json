{
  "name": "@fpp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "check": "drizzle-kit check",
    "format": "prettier --write \"src/**/*.{ts,json}\" drizzle.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,json}\" drizzle.config.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "validate": "bun run format:check && bun run lint && bun run type-check"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.22.6",
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
