{
  "name": "free-planning-poker",
  "version": "8.5.0",
  "private": true,
  "description": "Estimate your story points faster and easier with this free agile scrum sprint planning poker app. Open source and privacy focused.",
  "homepage": "https://free-planning-poker.com/",
  "author": "Johannes Krumm",
  "repository": {
    "type": "git",
    "url": "https://github.com/jkrumm/free-planning-poker"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "arena",
    "e2e"
  ],
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "release": "release-it",
    "dev": "bun --filter @fpp/api dev",
    "db:migrate": "bun --filter @fpp/api db:migrate",
    "sim": "bun packages/room-core/scripts/sim.ts",
    "bots": "bun packages/room-client/scripts/bots.ts",
    "i18n": "bun --filter @fpp/i18n run extract"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/tsgo": "0.70.0",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/bun": "1.4.4",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "release-it": "21.1.2",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "url": "https://free-planning-poker.com/"
}
