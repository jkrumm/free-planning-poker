{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push * v1)",
      "Bash(git push * v1 *)",
      "Bash(git push *:v1)",
      "Bash(git push *:v1 *)",
      "Bash(git push *:refs/heads/v1)",
      "Bash(git push * refs/heads/v1)",
      "Bash(git push *--force*master*)",
      "Bash(git push *-f *master*)",
      "Bash(git push *+master*)",
      "Bash(git push *+HEAD:master*)",
      "Bash(op read *)",
      "Bash(op run *)",
      "Bash(op inject *)",
      "Bash(op item get *)",
      "Bash(secrets-run read *)",
      "Bash(secrets-run run *)",
      "Bash(secrets-run export *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)"
    ]
  }
}
